{
  "manifest_version": 3,
  "name": "LinkedIn© Notifications Badge",
  "version": "1.0.3",
  "description": "Show notifications badge from LinkedIn© (all rights reserved)",
  "permissions": [
    "cookies",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    },
    "default_title": "LinkedIn© Notifications Badge\n\nClick to jump to Linkedin.com"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png",
    "512": "icons/icon.png"
  }
}
